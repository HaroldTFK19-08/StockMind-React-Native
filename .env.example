# Copia este archivo como .env y reinicia con: npx expo start -c
#
# URL base de la API, sin "/" al final. Ejemplos con Laravel:
#   Servidor publicado:     https://api.midominio.com/api/v1
#   Laravel en tu PC:       http://localhost:8000/api/v1
#     (en celular/emulador "localhost" se cambia solo por la IP de tu PC;
#      corre Laravel con: php artisan serve --host=0.0.0.0 --port=8000)
EXPO_PUBLIC_API_URL=http://localhost:8000/api/v1

# true = datos de prueba en memoria (sin backend), false = consume la API
EXPO_PUBLIC_USE_MOCKS=false

# Tiempo máximo de espera por petición, en milisegundos (1000 - 120000)
EXPO_PUBLIC_API_TIMEOUT=15000

# true = registra cada petición en la consola de Metro (solo en desarrollo)
EXPO_PUBLIC_API_DEBUG=false
