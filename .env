# URL base de la API (sin "/" al final). Las rutas de endpoints.js se agregan detrás.
EXPO_PUBLIC_API_URL=http://stockmind.com/v1
# true = datos de prueba en memoria, false = consume la API
EXPO_PUBLIC_USE_MOCKS=false
# Tiempo máximo de espera por petición, en milisegundos
EXPO_PUBLIC_API_TIMEOUT=15000
# true = muestra en la consola de Metro cada petición y respuesta (solo desarrollo)
EXPO_PUBLIC_API_DEBUG=true
